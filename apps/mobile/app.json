{
  "expo": {
    "name": "GAIN",
    "slug": "gain",
    "version": "0.19.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "backgroundColor": "#10120E",
    "userInterfaceStyle": "automatic",
    "scheme": "gain",
    "plugins": [
      "expo-sqlite",
      ["expo-localization", { "supportsRTL": true }],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#10120E"
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#B7F51B"
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/IBMPlexSans_400Regular.ttf",
            "./assets/fonts/IBMPlexSans_600SemiBold.ttf",
            "./assets/fonts/IBMPlexSans_700Bold.ttf",
            "./assets/fonts/IBMPlexSansArabic_400Regular.ttf",
            "./assets/fonts/IBMPlexSansArabic_600SemiBold.ttf",
            "./assets/fonts/IBMPlexSansArabic_700Bold.ttf"
          ]
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "app.gain.mobile",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "app.gain.mobile",
      "versionCode": 19,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": ["REQUEST_INSTALL_PACKAGES"],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#10120E"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
